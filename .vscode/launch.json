{
  // h3 studio runs under helmstudio and refuses to start without it, so there
  // is one configuration: the studio started by `debug: h3 studio` (scripts/run.sh
  // with H3_DLV), with the debugger attached to the Delve it puts in front of it.
  // Which model it runs against and where it keeps sessions are helm dev's,
  // set by H3_MODEL in .vscode/tasks.json.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "h3 studio",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 2345,
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "debug: h3 studio",
      "postDebugTask": "stop: h3 studio"
    }
  ]
}
