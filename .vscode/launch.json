{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "h3 studio (custom paths)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "env": {
        "GOCACHE": "${workspaceFolder}/.gocache",
        "H3_ZERO_COPY_WEIGHTS": "0"
      },
      "args": [
        "--h3",
        "${input:h3Path}",
        "--model",
        "${input:modelPath}",
        "--dev"
      ]
    },
    {
      "name": "h3 studio (dist build)",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/dist/h3studio",
      "preLaunchTask": "build: h3studio (dist)",
      "cwd": "${workspaceFolder}",
      "env": {
        "H3_ZERO_COPY_WEIGHTS": "0"
      },
      "args": [
        "--h3",
        "${workspaceFolder}/h3c/h3",
        "--model",
        "/Users/janisharali/GenAI/minimax-h3-mlx/MiniMax-H3"
      ]
    },
    {
      "name": "h3 studio (debug - source)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "env": {
        "GOCACHE": "${workspaceFolder}/.gocache",
        "H3_ZERO_COPY_WEIGHTS": "0"
      },
      "args": [
        "--h3",
        "${workspaceFolder}/h3c/h3",
        "--model",
        "/Users/janisharali/GenAI/minimax-h3-mlx/MiniMax-H3"
      ]
    },
    {
      "name": "h3 studio (dev - hot reload)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "env": {
        "GOCACHE": "${workspaceFolder}/.gocache",
        "H3_ZERO_COPY_WEIGHTS": "0"
      },
      "args": [
        "--h3",
        "${workspaceFolder}/h3c/h3",
        "--model",
        "/Users/janisharali/GenAI/minimax-h3-mlx/MiniMax-H3",
        "--host",
        "127.0.0.1",
        "--port",
        "8710",
        "--dev"
      ]
    },
    {
      "name": "h3 studio (prod - no hot reload)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "env": {
        "GOCACHE": "${workspaceFolder}/.gocache",
        "H3_ZERO_COPY_WEIGHTS": "0"
      },
      "args": [
        "--h3",
        "${workspaceFolder}/h3c/h3",
        "--model",
        "/Users/janisharali/GenAI/minimax-h3-mlx/MiniMax-H3",
        "--host",
        "0.0.0.0",
        "--port",
        "8710"
      ],
      "postDebugTask": "build: h3studio (dist)"
    }
  ],
  "inputs": [
    {
      "id": "h3Path",
      "type": "promptString",
      "description": "Full path to h3 binary",
      "default": "${workspaceFolder}/h3c/h3"
    },
    {
      "id": "modelPath",
      "type": "promptString",
      "description": "Full path to MiniMax-H3 model directory",
      "default": "/Users/janisharali/GenAI/minimax-h3-mlx/MiniMax-H3"
    }
  ]
}
