{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: h3studio (dist)",
      "type": "shell",
      "command": "go",
      "args": ["build", "-o", "./dist/h3studio", "."],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GOCACHE": "${workspaceFolder}/.gocache"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    }
  ]
}
