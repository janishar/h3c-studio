{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: h3studio (dist)",
      "type": "shell",
      "command": "go",
      "args": ["build", "-o", "./dist/h3studio", "."],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GOCACHE": "${workspaceFolder}/.gocache"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "test: go (race)",
      "type": "shell",
      "command": "go",
      "args": ["test", "-race", "./..."],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GOCACHE": "${workspaceFolder}/.gocache"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "test: canvas.js (node)",
      "type": "shell",
      "command": "node",
      "args": ["--test", "static/"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
